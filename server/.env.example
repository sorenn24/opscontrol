# Variables de entorno — OpsControl
# Copia este archivo como .env y rellena los valores reales

# ── MongoDB Atlas ──────────────────────────────────────────────
# Tu connection string de Atlas (incluye usuario y contraseña)
MONGODB_URI=mongodb+srv://TU_USUARIO:TU_PASSWORD@cluster0.xxxxx.mongodb.net/opscontrol?retryWrites=true&w=majority

# ── Sesiones ───────────────────────────────────────────────────
# Cadena larga y aleatoria para firmar las cookies de sesión
SESSION_SECRET=cambia_esto_por_una_cadena_secreta_muy_larga_2026

# ── Servidor ───────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── CORS ───────────────────────────────────────────────────────
# En producción pon tu URL de Render, en dev puedes dejar *
CLIENT_ORIGIN=*
